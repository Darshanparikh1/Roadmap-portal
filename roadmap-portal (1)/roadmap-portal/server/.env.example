# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Dedicated MongoDB instance for this project: its own data directory (<repo>/.data/db)
# on port 27018, so it never collides with the system-wide MongoDB service on 27017.
# Start it with: npm run db:start   (stop with: npm run db:stop)
MONGODB_URI=mongodb://127.0.0.1:27018/roadmap_portal
# Test suites create their own throwaway databases on the same instance.
MONGODB_TEST_URI=mongodb://127.0.0.1:27018

# ---- Pair-token auth ----
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_REUSE_GRACE_SECONDS=10      # tolerates two tabs refreshing at the same instant

# ---- Cookies ----
COOKIE_SECURE=false                 # must be true in production (HTTPS)
COOKIE_SAMESITE=lax                 # "none" only if the API and client are on different sites
COOKIE_DOMAIN=

# ---- Client / CORS ----
CLIENT_URL=http://localhost:5173    # used in verification and reset links
CORS_ORIGINS=http://localhost:5173  # comma-separated list

# ---- Email simulation ----
EMAIL_SIMULATION=true               # emails are stored and shown at /dev/mailbox in the app
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---- Abuse protection ----
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=5

# ---- Search ----
# auto = use the MongoDB text index, fall back to regex if the deployment has none
SEARCH_MODE=auto

# ---- First admin (created on startup if missing) ----
ADMIN_EMAIL=admin@roadmap.dev
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Product Team

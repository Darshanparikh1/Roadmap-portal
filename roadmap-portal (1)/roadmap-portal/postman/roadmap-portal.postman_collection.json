    {
      "name": "2 - Feature requests (create, feed, search)",
      "item": [
        {
          "name": "Create a feature request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Saved filters for the request feed\",\n  \"description\": \"I triage the same three views every morning.\\n\\n- Under review + most voted\\n- Integrations only\",\n  \"category\": \"ui_ux\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.collectionVariables.set(\"postId\", p.id); pm.collectionVariables.set(\"postSlug\", p.slug);",
                  "pm.test(\"own vote counted once\", () => { pm.expect(p.voteCount).to.eql(1); pm.expect(p.hasVoted).to.be.true; });",
                  "pm.test(\"starts under review\", () => pm.expect(p.status).to.eql(\"under_review\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation error (422)",

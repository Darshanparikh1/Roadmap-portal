    {
      "name": "3 - Atomic voting",
      "item": [
        {
          "name": "Vote (toggles off the author vote)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{postId}}/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "posts",
                "{{postId}}",
                "vote"
              ]
            },
            "description": "One atomic findOneAndUpdate per direction: the filter carries the guard, so a duplicate vote is impossible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"removed\", () => { const r = pm.response.json(); pm.expect(r.hasVoted).to.be.false; pm.expect(r.voteCount).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Vote again (toggles back on)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/posts/{{postId}}/vote",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "posts",
                "{{postId}}",
                "vote"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"added back exactly once\", () => { const r = pm.response.json(); pm.expect(r.hasVoted).to.be.true; pm.expect(r.voteCount).to.eql(1); });"
                ]
              }
            }
          ]
        }
      ]
    },

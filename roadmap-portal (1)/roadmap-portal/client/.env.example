# Where the Vite dev server proxies /api (the Express API)
VITE_API_PROXY_TARGET=http://localhost:5000
# Leave empty in development (same-origin via the proxy). Set when the built SPA is served
# from a different origin than the API, e.g. https://api.example.com
VITE_API_URL=
# Product name shown in the UI
VITE_PRODUCT_NAME=Throughline
